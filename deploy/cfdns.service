[Unit]
Description=Cloudflare DDNS daemon (cfdns)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kulimi
Group=kulimi
WorkingDirectory=/home/kulimi/Github/AutoUpdateCFDNS
ExecStart=/home/kulimi/Github/AutoUpdateCFDNS/.venv/bin/cfdns daemon
RuntimeDirectory=cfdns
RuntimeDirectoryMode=0755
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
